# تحديثٍ باسم تطبيقك.
android/key.properties
**/*.jks
**/*.keystore

# ملفّات خدمات المزوّدين (Firebase وغيرها) — تحمل معرّفاتٍ ومفاتيح.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# بيئةُ التشغيل المحلّيّة
.env
.env.*
!.env.example
